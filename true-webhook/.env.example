# Environment
DATABASE_URL=postgresql://user:password@localhost:5432/true_webhook
JWT_SECRET=your-secret-key-here-min-32-chars
CRON_SECRET=replace-with-a-random-secret
HEALTH_CHECK_SECRET=replace-with-a-random-secret
MASTER_SETUP_SECRET=replace-with-a-one-time-setup-secret

# Optional
PORT=3000
BASE_DOMAIN=tmw-monitors.com
NEXT_PUBLIC_BASE_DOMAIN=tmw-monitors.com
APP_ROOT=auto
TENANT_PREFIX=
SKIP_DB_SYNC=false
SKIP_SEED=false
DISABLE_BALANCE_WORKER=false
BALANCE_CHECK_INTERVAL=5000
CORS_ORIGINS=https://master.tmw-monitors.com,https://jga88.tmw-monitors.com
RUN_MIGRATIONS_ON_START=false
RUN_SEED_ON_START=false
ALLOW_TENANT_RECOVERY_TOOLS=false
LOCAL_JGA88_MODE=false
LOCAL_JGA88_USERNAME=
LOCAL_JGA88_PASSWORD=

# Optional release metadata (Railway commit SHA is detected automatically)
APP_VERSION=
BUILD_TIME=
